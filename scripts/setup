#!/usr/bin/env bash

set -e

cd "$(dirname "$0")/.."

python3 -m pip install --upgrade pip --root-user-action ignore
python3 -m pip install uv --root-user-action ignore
# pytest-homeassistant is versioned like Home Assistant. The lower bound skips an
# unrelated 0.1.x package of the same name (picked on Python older than 3.14.2).
# It must not be installed together with the discontinued
# pytest-homeassistant-custom-component (e.g. in an existing devcontainer).
# pytest-cov is required by the --cov options in pytest.ini.
uv pip uninstall --system pytest-homeassistant-custom-component
uv pip install --system --prerelease allow "pytest-homeassistant>=2026.11.0" pytest-cov
uv pip install --system --upgrade -r requirements.txt

rm -rf node_modules package-lock.json .devcontainer-lock.json
npm install --no-audit --no-fund

prek install
